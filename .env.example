# Znuny (OTRS) + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested digest for every image lives
# in the compose file's `x-images` block, so `git pull` delivers the
# version combination this repository has tested.

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.otrs.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Znuny (OTRS)
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
OTRS_HOSTNAME=otrs.example.com

# REQUIRED — generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
OTRS_DB_PASSWORD=change_me_before_first_start
OTRS_DB_ADMIN_PASSWORD=change_me_before_first_start
# Password for the root@localhost Znuny superuser account.
OTRS_ADMIN_PASSWORD=change_me_before_first_start

# Defaults below are set in the compose file; override only to diverge.
# OTRS_DB_NAME=otrsdb
# OTRS_DB_USER=otrsdbbuser
# OTRS_LANGUAGE=en
# OTRS_TIMEZONE=UTC
# OTRS_TICKET_COUNTER=1
# OTRS_NUMBER_GENERATOR=AutoIncrement

# ──────────────────────────────────────────────────────────────────────────────
# SMTP (optional — outgoing mail is off unless you set these)
# ──────────────────────────────────────────────────────────────────────────────

# OTRS_SMTP_ADDRESS=smtp.example.com
# OTRS_SMTP_PORT=587
# OTRS_SMTP_USER_NAME=otrs@example.com
# OTRS_SMTP_PASSWORD=change_me

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# MARIADB_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# MARIADB_BACKUPS_PATH=/srv/otrs-mariadb/backups
# DATA_BACKUPS_PATH=/srv/otrs-application-data/backups
# DATA_PATH=/opt/otrs
# MARIADB_BACKUP_NAME=otrs-mariadb-backup
# DATA_BACKUP_NAME=otrs-application-data-backup
